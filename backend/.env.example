# Example backend env for Firebase
# Option A (recommended): point to a local service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: raw JSON string (useful on platforms that only allow env vars)
# Put the entire service account JSON as a single-line string. Make sure it's valid JSON and properly escaped.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# The backend will read one of the above environment variables to initialize the Firebase Admin SDK.
# In production, set one of these variables in your host's environment (Render, Railway, Fly, etc.).

# Port used by many hosts (optional)
PORT=8000
